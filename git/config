[user]
	name = Thomas Juranek
	email = dev@thomasjuranek.com
    signingkey = ~/.ssh/id_ed25519.pub

[github]
    user = tjuranek

[core]
    editor = nvim
    autocrlf = input

[init]
    defaultBranch = master

[pull]
    rebase = false

[push]
    default = simple
    autoSetupRemote = true

[color]
    ui = auto

[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers

[credential]
	helper = osxkeychain
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
